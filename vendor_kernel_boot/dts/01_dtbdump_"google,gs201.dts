/dts-v1/;

/ {
	soc_id = <0x9855000 0x00>;
	#address-cells = <0x02>;
	#size-cells = <0x01>;
	compatible = "google,gs201";
	interrupt-parent = <0x01>;

	bootloader_log {
		compatible = "google,bldr_log";
		reg = <0x00 0xfd800000 0x80000 0x00 0xfd880000 0x80000>;
		reg-names = "bl_log\0bl_old_log";
		memory-region = <0x02>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x01>;
		ranges;
		phandle = <0x19c>;

		ect_binary {
			reg = <0x00 0x90000000 0x3a000>;
			phandle = <0x174>;
		};

		gsa@90200000 {
			reg = <0x00 0x90200000 0x400000>;
			no-map;
			phandle = <0x19d>;
		};

		tpu_ctx@91E00000 {
			reg = <0x00 0x91e00000 0x1200000>;
			no-map;
			phandle = <0xc5>;
		};

		tpu_fw@93000000 {
			reg = <0x00 0x93000000 0x1000000>;
			no-map;
			phandle = <0xc4>;
		};

		aoc@94000000 {
			reg = <0x00 0x94000000 0x3000000>;
			no-map;
			phandle = <0x5d>;
		};

		gxp_fw@98000000 {
			reg = <0x00 0x98000000 0x400000>;
			no-map;
			phandle = <0xca>;
		};

		gxp_scratchpad@98400000 {
			reg = <0x00 0x98400000 0x100000>;
			no-map;
			phandle = <0xcb>;
		};

		abl@f8800000 {
			reg = <0x00 0xf8800000 0x2000000>;
			no-map;
			phandle = <0x19e>;
		};

		dss_log_reserved@fd3f0000 {
			reg = <0x00 0xfd3f0000 0xe000>;
			no-map;
			phandle = <0x19f>;
		};

		debug_kinfo_reserved@fd3fe000 {
			reg = <0x00 0xfd3fe000 0x1000>;
			no-map;
			phandle = <0x14b>;
		};

		suspend_diag_log_reserved@fd90c000 {
			reg = <0x00 0xfd90c000 0x1000>;
			no-map;
			phandle = <0x14c>;
		};

		ramoops_mem@fd3ff000 {
			compatible = "ramoops";
			reg = <0x00 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		bldr_log_reserved@fd800000 {
			reg = <0x00 0xfd800000 0x100000>;
			no-map;
			phandle = <0x02>;
		};

		cp_rmem {
			compatible = "exynos,modem_if";
			reg = <0x00 0xea400000 0x800000>;
			rmem_index = <0x00>;
			phandle = <0x1a0>;
		};

		cp_msi_rmem {
			compatible = "exynos,modem_if";
			reg = <0x00 0xf6200000 0x1000>;
			rmem_index = <0x01>;
			phandle = <0x1a1>;
		};

		cp_rmem_1 {
			compatible = "exynos,modem_if";
			reg = <0x00 0xe8000000 0x2000000>;
			rmem_index = <0x02>;
			phandle = <0x1a2>;
		};

		cp_aoc_rmem {
			compatible = "exynos,modem_if";
			reg = <0x00 0x197fd000 0x3000>;
			rmem_index = <0x03>;
			phandle = <0x1a3>;
		};

		header {
			reg = <0x00 0xd8100000 0x10000>;
			no-map;
			phandle = <0x142>;
		};

		log_kevents {
			reg = <0x00 0xd8110000 0x700000>;
			no-map;
			phandle = <0x143>;
		};

		log_bcm {
			reg = <0x00 0xdd610000 0x400000>;
			no-map;
			phandle = <0x144>;
		};

		log_s2d {
			reg = <0x00 0xd8810000 0x1800000>;
			no-map;
			phandle = <0x145>;
		};

		log_array_reset {
			reg = <0x00 0xda010000 0xa00000>;
			no-map;
			phandle = <0x146>;
		};

		log_array_panic {
			reg = <0x00 0xdaa10000 0xa00000>;
			no-map;
			status = "disabled";
			phandle = <0x147>;
		};

		log_slcdump {
			reg = <0x00 0xdb410000 0x1100000>;
			no-map;
			status = "disabled";
			phandle = <0x148>;
		};

		log_preslcdump {
			reg = <0x00 0xdc510000 0x1100000>;
			no-map;
			status = "disabled";
			phandle = <0x149>;
		};

		log_itmon {
			reg = <0x00 0xdda10000 0x10000>;
			no-map;
			phandle = <0x14a>;
		};

		seclog_mem {
			compatible = "exynos,seclog";
			reg = <0x00 0xc3000000 0x80000>;
			phandle = <0x188>;
		};

		vstream {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x4800000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x09 0x80000000 0x80000000 0x09 0x00 0x80000000 0x08 0x80000000 0x80000000 0x00 0x80000000 0x80000000>;
			phandle = <0x03>;
		};

		vframe {
			compatible = "shared-dma-pool";
			size = <0x20000000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x09 0x80000000 0x80000000 0x09 0x00 0x80000000 0x08 0x80000000 0x80000000 0x00 0x80000000 0x80000000>;
			reusable;
			phandle = <0x04>;
		};

		vscaler {
			compatible = "shared-dma-pool";
			size = <0x3400000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x09 0x80000000 0x80000000 0x09 0x00 0x80000000 0x08 0x80000000 0x80000000 0x00 0x80000000 0x80000000>;
			reusable;
			phandle = <0x05>;
		};

		tui {
			size = <0x3000000>;
			alloc-ranges = <0x00 0x80000000 0x80000000>;
			alignment = <0x00 0x10000>;
			phandle = <0x06>;
		};

		xhci_dma@97000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x97000000 0x400000>;
			no-map;
			phandle = <0x17b>;
		};

		faceauth_tpu {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x2000000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x09 0x80000000 0x80000000 0x09 0x00 0x80000000 0x08 0x80000000 0x80000000 0x00 0x80000000 0x80000000>;
			status = "disabled";
			phandle = <0x07>;
		};

		famodel {
			size = <0x4b00000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x09 0x80000000 0x80000000 0x09 0x00 0x80000000 0x08 0x80000000 0x80000000 0x00 0x80000000 0x80000000>;
			status = "disabled";
			phandle = <0xcc>;
		};

		faimg {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x3c00000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x09 0x80000000 0x80000000 0x09 0x00 0x80000000 0x08 0x80000000 0x80000000 0x00 0x80000000 0x80000000>;
			status = "disabled";
			phandle = <0x08>;
		};

		farawimg {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x10000000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x09 0x80000000 0x80000000 0x09 0x00 0x80000000 0x08 0x80000000 0x80000000 0x00 0x80000000 0x80000000>;
			status = "disabled";
			phandle = <0x09>;
		};

		faprev {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x3000000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x09 0x80000000 0x80000000 0x09 0x00 0x80000000 0x08 0x80000000 0x80000000 0x00 0x80000000 0x80000000>;
			status = "disabled";
			phandle = <0x0a>;
		};

		mfc_fw {
			size = <0x210000>;
			alloc-ranges = <0x00 0x80000000 0x80000000>;
			alignment = <0x00 0x10000>;
			phandle = <0x0b>;
		};
	};

	trusty {
		compatible = "android,trusty-smc-v1";
		phandle = <0x1a4>;

		irq {
			compatible = "android,trusty-irq-v1";
			ipi-range = <0x08 0x0f 0x08>;
		};

		log {
			compatible = "android,trusty-log-v1";
		};

		virtio {
			compatible = "android,trusty-virtio-v1";
		};

		video_stream_dma_heap {
			compatible = "samsung,dma-heap-chunk";
			memory-region = <0x03>;
			dma-heap,name = "vstream";
			dma-heap,video_aligned;
			dma-heap,secure;
			dma-heap,protection_id = <0x03>;
			dma-heap,alignment = <0x10000>;
		};

		video_frame_dma_heap {
			compatible = "samsung,dma-heap-chunk";
			memory-region = <0x04>;
			dma-heap,name = "vframe";
			dma-heap,secure;
			dma-heap,protection_id = <0x05>;
			dma-heap,alignment = <0x10000>;
		};

		video_scaler_dma_heap {
			compatible = "samsung,dma-heap-chunk";
			memory-region = <0x05>;
			dma-heap,name = "vscaler";
			dma-heap,secure;
			dma-heap,protection_id = <0x06>;
			dma-heap,alignment = <0x10000>;
		};

		tui_dma_heap {
			compatible = "samsung,dma-heap-carveout";
			memory-region = <0x06>;
			dma-heap,name = "tui";
			dma-heap,secure;
			dma-heap,protection_id = <0x14>;
			dma-heap,alignment = <0x10000>;
		};

		faceauth_tpu_dma_heap {
			compatible = "samsung,dma-heap-chunk";
			memory-region = <0x07>;
			dma-heap,name = "faceauth_tpu";
			dma-heap,secure;
			dma-heap,protection_id = <0x0f>;
			dma-heap,alignment = <0x10000>;
			status = "disabled";
			phandle = <0x1a5>;
		};

		faceauth_image_heap {
			compatible = "samsung,dma-heap-cma";
			memory-region = <0x08>;
			dma-heap,name = "faimg";
			dma-heap,secure;
			dma-heap,protection_id = <0x10>;
			dma-heap,alignment = <0x10000>;
			status = "disabled";
			phandle = <0x1a6>;
		};

		faceauth_rawimage_heap {
			compatible = "samsung,dma-heap-cma";
			memory-region = <0x09>;
			dma-heap,name = "farawimg";
			dma-heap,secure;
			dma-heap,protection_id = <0x11>;
			dma-heap,alignment = <0x10000>;
			status = "disabled";
			phandle = <0x1a7>;
		};

		faceauth_preview_heap {
			compatible = "samsung,dma-heap-cma";
			memory-region = <0x0a>;
			dma-heap,name = "faprev";
			dma-heap,secure;
			dma-heap,protection_id = <0x12>;
			dma-heap,alignment = <0x10000>;
			status = "disabled";
			phandle = <0x1a8>;
		};

		mfc_fw_dma_heap {
			compatible = "samsung,dma-heap-carveout";
			memory-region = <0x0b>;
			dma-heap,name = "mfc_fw";
			dma-heap,secure;
			dma-heap,protection_id = <0x02>;
			dma-heap,alignment = <0x10000>;
		};
	};

	exynos-bts {
		compatible = "samsung,exynos-bts";
		#address-cells = <0x02>;
		#size-cells = <0x01>;
		ranges;
		bus1_int_map = <0x975e0 0x82208 0x82208 0x71868 0x61a80 0x510e0 0x4baf0 0x412f8 0x412f8 0x30d40 0x30d40 0x25d78 0x20b70 0x186a0>;
		list-scen = "default\0mfc_uhd\0mfc_uhd_10bit\0mfc_8k_dec30\0g3d_performance\0tpu_performance\0dp_default\0camera_default\0mfc_uhd_enc60";
		rt-names = "DECON0\0DECON1\0DECON2\0csi\0ipp\0g3aa";

		bts_corem0 {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			ranges;
			reg = <0x00 0x1e4b4000 0x400>;
			status = "okay";
			bts-type = <0x02>;
		};

		bts_corem1 {
